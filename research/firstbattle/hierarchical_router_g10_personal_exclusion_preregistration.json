  "principles": {
    "single_goal": "交付只属于该个人账户的三重排除倒序 Brain：先圈定机构、普通散户、通用机器人难以参与的合法区域，再只从具备历史可入场证明的盈利录像倒序生成个人剧本。",
    "research_order": "个人条件 → 三重排除区域 → 历史可入场盈利录像 → 倒序重建事件 → 独立历史证伪；禁止从公共因子正向预测。",
    "okx_only_execution": "所有模拟与执行订单仅在 OKX；Binance、Bybit、Gate 等仅提供严格 PIT 的上线、下线、维护和交易状态变化信息。",
    "terminal_risk_ceilings_not_targets": "单事件终局损失硬上限 40%、账户同时终局风险硬上限 70% 是绝对天花板而非建议仓位；Brain 必须按机会证据和强平距离向下 sizing，不能因为上限高而主动放大。",
    "floating_loss_tolerated": "允许大幅浮亏、隔夜持仓、跨 funding 结算；论点失效由 ThesisHealth/StopError 退出，禁止机械补仓和向上凑单。",
    "triple_exclusion_required": "每个候选必须分别证明机构、普通散户、通用机器人为何难以进入或缺乏参与动机；不能证明排除理由的事件不得进入倒序挖掘。",
    "entry_execution_exit_proofs": "每个候选必须冻结 EntryProof、ExecutionPolicyProof、ExitProof；只证明能开仓但不能退出的录像不得成为赢家。",
    "maker_taker_skip_not_default": "BOUNDED_MAKER / CONDITIONAL_MARKETABLE_LIMIT / SKIP 必须在同一决策时点冻结并反事实比较；不得先看结果再挑执行方式。",
    "fail_closed": "未知、歧义、OOD、执行指纹 UNKNOWN、ENTRY_UNPROVEN、公告 lookahead 一律 fail closed；无真钱动作。",
    "no_future_wait": "只使用决策时刻可见、已完整收盘的历史字段；无合法预留卷时 EXAM_UNAVAILABLE/NO_GO，不等待未来。",
    "exam_actions_zero": "G10 Personal-Exclusion 研究阶段 exam_actions=0；trade_allowed=false。",
    "low_cpu_checkpoint": "默认 GOMAXPROCS=1、低优先级、分片 checkpoint；禁止长链一次跑满服务器。",
    "full_history_validation": "使用完整已有历史做正式 validation/WF；禁止用 3 标的 smoke 代替正式结论。"
  },
