# lingxi-watchdog.service —— 看门狗的 oneshot 单元,由 lingxi-watchdog.timer 周期触发(S7-D)。
#
# 安装(与 lingxi-watchdog.timer 一起):
#   sudo cp deploy/lingxi-watchdog.service deploy/lingxi-watchdog.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now lingxi-watchdog.timer
#
# 说明:看门狗作为独立单元运行,不依赖被监控进程;心跳卡死/healthz 异常达阈值即重启 lingxi。
# 通过 Environment= 覆盖 watchdog.sh 的默认阈值/告警 webhook。

[Unit]
Description=lingxi external watchdog (heartbeat + healthz)
After=lingxi.service

[Service]
Type=oneshot
# 与 lingxi.service 一致:实际部署在 /root/lingxi、root 运行(systemctl restart 也需要 root)。
User=root
Group=root
WorkingDirectory=/root/lingxi
Environment=LINGXI_HEALTH_URL=http://127.0.0.1:8080/healthz
Environment=LINGXI_RECORD_DIR=/root/lingxi/records
Environment=LINGXI_STALE_THRESHOLD=90
Environment=LINGXI_FAIL_THRESHOLD=3
# 注意:含空格的值必须整体加引号,否则 systemd 按空格切分 → "restart"/"lingxi" 被当成非法赋值忽略,该变量失效。
Environment="LINGXI_RESTART_CMD=systemctl restart lingxi"
# 兜底强平开关:阶段一保持注释(只告警);零误报观察 1–2 周后再放开(见 ROADMAP §3)。
# Environment=LINGXI_FLATTEN_ON_DEAD=1
# 可选告警出口(钉钉/飞书/Telegram 中转):Environment=LINGXI_ALERT_WEBHOOK=https://...
ExecStart=/root/lingxi/deploy/watchdog.sh
