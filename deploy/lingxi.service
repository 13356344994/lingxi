# lingxi.service —— systemd 主进程单元(S7-D / R14)。
#
# 安装:
#   sudo cp deploy/lingxi.service /etc/systemd/system/lingxi.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now lingxi
#
# 要点:
#   - Restart=always + RestartSec:进程异常退出自动拉起(配合 dead-man,崩溃期间挂单由交易所兜底撤销);
#   - TimeoutStopSec 给足优雅停机收尾时间(S7-C 的 finalizeGracefulShutdown 默认 10s 上限,这里留 30s);
#   - KillSignal=SIGTERM:触发 main.go 的 signal.NotifyContext → 取消 ctx → 优雅停机;
#   - 单写租约(S7-A)从底层杜绝重复拉起导致的双开。
#
# 注意:必须用 systemd 启动(systemctl start lingxi),不要手动 nohup 起进程——
# 手动起的进程不受 Restart=always 保护,崩溃后无人拉起。

[Unit]
Description=lingxi funding-rate arbitrage engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/lingxi
# 二进制在 /root 下,SELinux(Enforcing)默认标签 admin_home_t/user_tmp_t,init_t 无权 execute → 203/EXEC。
# 部署时执行一次:`semanage fcontext -a -t bin_t /root/lingxi/lingxi`,并让 start.sh 每次 go build 后 restorecon 重打标。
# 用 sh -c + exec 把 stdout/stderr 追加到与原 nohup 同一份日志(systemd 239 的 append:/file: 不保证可用);
# exec 确保 PID 即 lingxi 本体,KillSignal=SIGTERM 直达进程触发优雅停机。
ExecStart=/bin/sh -c 'exec /root/lingxi/lingxi >> /root/lingxi/records/lingxi_server.log 2>&1'
# 重启后是否恢复交易由各所 records/{venue}_directional/control.json 的 active 字段决定(引擎启动时恢复)。
# 历史上的 LINGXI_AUTOSTART_LIVE 环境变量在 2026-07-02 大精简后代码已不读取(幽灵开关),故删除,勿再依赖。
# 优雅停机:发 SIGTERM,给足收尾时间(落盘/停用 dead-man/平仓善后)。
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5
# 资源/安全收紧(按需调整)。
LimitNOFILE=65536
NoNewPrivileges=true
# 运行目录在 /root 下,必须关闭 ProtectHome,否则 systemd 屏蔽 /root → 读不到二进制/secret.yaml/records。
ProtectHome=false
ProtectSystem=full
ReadWritePaths=/root/lingxi

[Install]
WantedBy=multi-user.target
