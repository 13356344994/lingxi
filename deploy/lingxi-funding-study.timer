[Unit]
Description=Run lingxi funding-moment study 4x daily (after 00/08/16 UTC settlements + noon catch-up)

[Timer]
OnCalendar=*-*-* 01:10:00 UTC
OnCalendar=*-*-* 09:10:00 UTC
OnCalendar=*-*-* 13:10:00 UTC
OnCalendar=*-*-* 17:10:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
