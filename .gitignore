.DS_Store
.idea/
.vscode/

# Local runtime state
# .lingxi.pid
# 仅忽略编译出的二进制(根目录与 cmd 内),不要忽略 cmd/lingxi 源码目录。
/lingxi
/cmd/lingxi/lingxi
*.pid
# 原子写中间产物(writeJSONFile 先写 .tmp 再 rename;偶被 git add -A 抢拍到)
*.tmp

# Secrets and local-only config
# secret.yaml
# secret.local.yaml
# config.local.yaml
# config.local.json

# Generated records and caches (logs/records 纳入版本库,由用户要求全量提交)
.gocache/
.cache/

# Go build/test artifacts

# 运行时大日志(无限增长,曾超 GitHub 100MB 硬限)——移出版本库,本地保留
records/opportunities/
records/crossvenue/scan_snapshots.jsonl

# 大体积研究数据(不进库,超GitHub 100MB限制)
records/archive/
records/*/fast_dynamic_feature_events.jsonl
records/*/fast_executable_shadow_events.jsonl
records/crossvenue/fast_peer_leadlag_events.jsonl
